{
  "format": "short-circ/2",
  "type": "pushbutton",
  "name": "Pushbutton",
  "category": "electromechanical",
  "pins": [
    {"id":"a"},
    {"id":"b"},
    {"id":"a2","name":"A2"},
    {"id":"b2","name":"B2"}
  ],
  "buses": [
    ["a","a2"],
    ["b","b2"]
  ],
  "schematic": {
    "size": [6,3],
    "pins": {
      "a": {"at":[0,2],"dir":"left"},
      "b": {"at":[6,2],"dir":"right"}
    },
    "shapes": [
      {"k":"line","pts":[[0,2],[1.5,2]]},
      {"k":"circle","at":[1.5,2],"r":0.2},
      {"k":"circle","at":[4.5,2],"r":0.2},
      {"k":"line","pts":[[4.5,2],[6,2]]},
      {"k":"line","pts":[[1.5,1.2],[4.5,1.2]]},
      {"k":"line","pts":[[3,1.2],[3,0.4]]},
      {"k":"line","pts":[[2.2,0.4],[3.8,0.4]]},
      {"k":"text","at":[3,-0.3],"text":"{ref}","size":0.9,"anchor":"middle"},
      {"k":"text","at":[3,4.1],"text":"{value}","size":0.9,"anchor":"middle"}
    ]
  },
  "breadboard": {
    "size": [3,4],
    "pins": {
      "a": {"at":[0,1]},
      "b": {"at":[3,1]},
      "a2": {"at":[0,3]},
      "b2": {"at":[3,3]}
    },
    "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 40'><line x1='0' y1='10' x2='5' y2='10' stroke='#b0b0b0' stroke-width='1.6'/><line x1='25' y1='10' x2='30' y2='10' stroke='#b0b0b0' stroke-width='1.6'/><line x1='0' y1='30' x2='5' y2='30' stroke='#b0b0b0' stroke-width='1.6'/><line x1='25' y1='30' x2='30' y2='30' stroke='#b0b0b0' stroke-width='1.6'/><rect x='3' y='4' width='24' height='32' fill='#37474f' rx='2' stroke='#1c272c' stroke-width='1'/><circle cx='15' cy='20' r='8' fill='#212121' stroke='#90a4ae' stroke-width='1'/><circle cx='13' cy='18' r='2.5' fill='#455a64'/></svg>"
  },
  "meta": {
    "note": "tactile switch, legs of the same side are always connected (a-a2, b-b2); a2 and b2 exist only on the breadboard"
  }
}
