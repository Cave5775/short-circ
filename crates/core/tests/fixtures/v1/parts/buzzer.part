{
  "format": "short-circ/1",
  "type": "buzzer",
  "name": "Buzzer",
  "category": "output",
  "size": [4, 4],
  "pins": [
    {"id": "pos", "at": [0, 1], "dir": "left"},
    {"id": "neg", "at": [0, 3], "dir": "left"}
  ],
  "shapes": [
    {"k": "line", "pts": [[0, 1], [2, 1]]},
    {"k": "line", "pts": [[0, 3], [2, 3]]},
    {"k": "line", "pts": [[2, 0], [2, 4]]},
    {"k": "arc", "at": [2, 2], "r": 2, "from": 270, "to": 90},
    {"k": "text", "at": [0.4, 0.6], "text": "+", "size": 0.9, "anchor": "start"},
    {"k": "text", "at": [4.6, 1.8], "text": "{ref}", "size": 0.9, "anchor": "start"},
    {"k": "text", "at": [4.6, 3], "text": "{value}", "size": 0.9, "anchor": "start"}
  ]
}
