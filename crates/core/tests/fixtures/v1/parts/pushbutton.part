    {"k": "circle", "at": [1.5, 2], "r": 0.2},
    {"k": "circle", "at": [4.5, 2], "r": 0.2},
    {"k": "line", "pts": [[4.5, 2], [6, 2]]},
    {"k": "line", "pts": [[1.5, 1.2], [4.5, 1.2]]},
    {"k": "line", "pts": [[3, 1.2], [3, 0.4]]},
