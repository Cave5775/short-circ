  "meta": {
    "pin_naming": "Terminal strips: a letter a-j and the column number 1..30, e.g. a1, e17, f30 (a-e is the upper half, f-j the lower half, the centre channel lies between e and f). Each half column is one bus. Rails: t+N and t-N (top, outer row t+, N = 1..25 from the left), b-N and b+N (bottom, outer row b+); rail holes sit on columns 3..27. Each rail row is one bus.",
    "tie_points": "400"
  }
}
