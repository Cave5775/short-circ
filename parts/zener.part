    "svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 20'><line x1='0' y1='10' x2='12' y2='10' stroke='#b0b0b0' stroke-width='1.6'/><line x1='28' y1='10' x2='40' y2='10' stroke='#b0b0b0' stroke-width='1.6'/><rect x='11' y='6' width='18' height='8' fill='#e0a458' rx='3' stroke='#8d5a2b' stroke-width='1'/><rect x='24' y='6' width='3' height='8' fill='#111111'/></svg>"
  },
